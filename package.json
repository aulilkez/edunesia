{
  "name": "edunesia",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run vp run web#dev",
    "build": "bun run vp run web#build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run vp lint",
    "lint:fix": "bun run vp lint --fix",
    "format": "bun run vp fmt --write",
    "format:check": "bun run vp fmt --check",
    "test": "bun run vp test --run",
    "test:watch": "bun run vp test --watch",
    "test:coverage": "bun run vp test --run --coverage",
    "test:ui": "bun run vp test --ui --watch --no-open",
    "test:e2e": "bun run vp run web#test:e2e",
    "storybook": "bun run vp run web#storybook",
    "storybook:build": "bun run vp run web#storybook:build",
    "test:load": "k6 run tooling/k6/trpc-health.js",
    "check": "bun run vp check && bun run typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "vp run @edunesia/database#db:generate",
    "db:migrate": "vp run @edunesia/database#db:migrate",
    "db:studio": "vp run @edunesia/database#db:studio",
    "prepare": "vp config --no-hooks && lefthook install"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "katex": "0.19.1",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "patchedDependencies": {
    "@tanstack/start-plugin-core@1.171.55": "patches/@tanstack%2Fstart-plugin-core@1.171.55.patch"
  }
}

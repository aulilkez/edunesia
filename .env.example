APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edunesia
BETTER_AUTH_SECRET=edunesia-local-development-secret-change-before-deploy
BETTER_AUTH_URL=http://localhost:3000
# Development default targets a local Mailpit/Ethereal-compatible SMTP catcher.
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=auth@localhost
SMTP_FROM_NAME=Edunesia
VITE_APP_NAME=Edunesia
VITE_APP_URL=http://localhost:3000
# Optional OAuth providers. Both values are needed to enable each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

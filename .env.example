APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edunesia
BETTER_AUTH_SECRET=edunesia-local-development-secret-change-before-deploy
BETTER_AUTH_URL=http://localhost:3000

# Local SMTP catcher (Mailpit/Ethereal compatible)
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=auth@localhost
SMTP_FROM_NAME=Edunesia

VITE_APP_NAME=Edunesia
VITE_APP_URL=http://localhost:3000

# Optional OAuth providers. Set both values to enable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
